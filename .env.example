# Opcional: dejar vacío para usar el proxy same-origin `/api/*` (recomendado).
NEXT_PUBLIC_API_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# UploadThing
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# OpenAI (solo servidor)
OPENAI_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web3 / Wallet Connect
# Obtén tu projectId en: https://cloud.walletconnect.com (plan gratuito disponible)
# Sin este ID el botón de wallet abre en modo demo (solo MetaMask injected funcionará)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# CoinGecko API
# El plan gratuito (Demo API) no requiere key pero tiene límites de rate.
# Regístrate en https://www.coingecko.com/en/api para obtener una key gratuita.
# Sin key, las llamadas funcionan pero pueden ser limitadas por IP.
COINGECKO_API_KEY=

# MongoDB (nuevo backend apps/api)
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
# Use a separate schema-management credential outside local development.
MONGODB_MIGRATION_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=legabit
API_HOST=0.0.0.0
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# Autenticación self-hosted (Better Auth en apps/api)
# Genera un secreto de al menos 32 caracteres y almacénalo en el gestor de secretos.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Google OAuth de Better Auth. Redirect local autorizado:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Marketing (landing) — opcional; si vacío se usan los enlaces públicos por defecto
NEXT_PUBLIC_LEGABIT_DISCORD_URL=https://discord.gg/jtz9dve2
NEXT_PUBLIC_LEGABIT_TELEGRAM_URL=https://t.me/Legabit_org
NEXT_PUBLIC_LEGABIT_YOUTUBE_URL=https://www.youtube.com/@legabitERC-20
NEXT_PUBLIC_LEGABIT_SPOTIFY_URL=https://open.spotify.com/search/Legabit
# Compatibilidad: si no defines DISCORD_URL, puede usarse solo este para Discord
NEXT_PUBLIC_LEGABIT_COMMUNITY_URL=
