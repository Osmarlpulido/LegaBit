// LEGABIT — PostgreSQL es la fuente de verdad. RLS en Supabase complementa el aislamiento por tenant.
// Identidad: supabaseUserId (UUID del JWT de Supabase Auth) es la clave de identidad externa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationType {
  LAW_FIRM
  STARTUP
  SME
  EDUCATIONAL
}

/// Roles por organización. `super_admin` de plataforma: ver `User.platformRole`.
enum MembershipRole {
  organization_owner
  admin
  legal_operator
  educator
  student
  client
  community_moderator
}

enum PlatformRole {
  none
  super_admin
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

/// Usuario interno; `supabaseUserId` es el UUID del JWT de Supabase Auth (campo `sub`).
model User {
  id              String       @id @default(cuid())
  supabaseUserId  String       @unique
  email           String
  displayName     String?
  imageUrl        String?
  platformRole    PlatformRole @default(none)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships     Membership[]
  invitationsSent OrganizationInvitation[] @relation("InvitationInviter")
  auditLogs       AuditLog[]

  @@index([supabaseUserId])
  @@index([email])
}

/// Organización (tenant).
model Organization {
  id                    String           @id @default(cuid())
  externalOrganizationId String?         @unique
  name                  String
  slug                  String           @unique
  type                  OrganizationType
  stripeCustomerId      String?          @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships  Membership[]
  invitations  OrganizationInvitation[]
  auditLogs    AuditLog[]

  @@index([slug])
}

/// Membresía: RBAC por organización. `super_admin` a nivel plataforma vive en `User.platformRole`.
model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole
  tokenHash      String           @unique
  status         InvitationStatus @default(pending)
  invitedById    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

/// Registro de auditoría append-only para mutaciones sensibles (ampliar por dominio).
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

/// Suscriptores públicos al newsletter (landing / marketing). Independiente del modelo `User` (Clerk).
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  phone        String?
  /// landing, footer, popup, etc.
  source       String   @default("landing")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ─── Contenido de la plataforma ──────────────────────────────────────────────

enum EventFormat {
  VIRTUAL
  PRESENCIAL
  HIBRIDO
}

enum EventTrack {
  DERECHO
  TECNOLOGIA
  FINANZAS
  COMUNIDAD
}

enum EventStatus {
  UPCOMING
  PAST
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  tag         String
  title       String
  excerpt     String
  content     String    @db.Text
  readingTime String?
  author      String    @default("Equipo Legabit")
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([publishedAt])
}

model Course {
  id       String  @id @default(cuid())
  slug     String  @unique
  tag      String
  title    String
  excerpt  String
  level    String
  duration String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lessons Lesson[]

  @@index([slug])
}

model Lesson {
  id            String  @id @default(cuid())
  courseId      String
  order         Int
  title         String
  durationMin   Int
  videoEmbedSrc String?
  brief         String  @db.Text
  cta           String?
  project       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model PodcastEpisode {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String    @db.Text
  topic       String
  duration    String
  youtubeUrl  String?
  spotifyUrl  String?
  publishedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([publishedAt])
}

model LegabitEvent {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String      @db.Text
  eventDate   DateTime
  eventTime   String
  format      EventFormat
  location    String
  track       EventTrack
  status      EventStatus @default(UPCOMING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventDate])
  @@index([status])
}
